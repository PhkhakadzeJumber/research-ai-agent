ANTHROPIC_API_KEY='your-anthropic-api-key'
OPENWEATHER_API_KEY='your-openweathermap-key'

# Claude settings used by src/config.py
# Model ID, e.g. claude-opus-5-5 (required)
EUREKA_LLM_MODEL=
# Default reasoning effort: low | medium | high | xhigh | max (optional, default: medium)
EUREKA_LLM_EFFORT=
# Default output token limit per call (optional, default: 16000)
EUREKA_LLM_MAX_TOKENS=
