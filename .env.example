ANTHROPIC_API_KEY='your-anthropic-api-key'
OPENWEATHER_API_KEY='your-openweathermap-key'

# Claude settings used by src/config.py
# Model ID, e.g. claude-opus-5-5 (required)
EUREKA_LLM_MODEL=
# Default reasoning effort: low | medium | high | xhigh | max (optional, default: medium)
EUREKA_LLM_EFFORT=
# Default output token limit per call (optional, default: 16000)
EUREKA_LLM_MAX_TOKENS=
# Per-role overrides (optional): EUREKA_LLM_MODEL_<ROLE> / EUREKA_LLM_EFFORT_<ROLE>.
# Relevance screening judges hundreds of abstracts per evaluation: a small model is enough,
# e.g. claude-haiku-5-5 (about 40x cheaper than Opus)
EUREKA_LLM_MODEL_RELEVANCE_SCREENING=

# Literature sources
# Free personal OpenAlex key from https://openalex.org/settings/api (optional but recommended:
# without it, requests share a tiny daily budget per IP address)
OPENALEX_API_KEY=
# Contact email sent to OpenAlex (optional)
OPENALEX_MAILTO=

# Local database (Docker, compose.yaml). Only the password is required; choose any strong one.
# It's set once when the database is first created: changing it later needs `docker compose down -v`.
POSTGRES_PASSWORD=
# Optional, with defaults: user eureka, database eureka, host 127.0.0.1, port 5434, test database eureka_test
# (use 127.0.0.1, not "localhost": on Windows "localhost" adds ~2 s to every new connection)
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_TEST_DB=
# Cloud only: a full SQLAlchemy URL (e.g. Cloud SQL) instead of the POSTGRES_* values
DATABASE_URL=
TEST_DATABASE_URL=

# Embeddings (Vertex AI). Credentials are NOT here: run `gcloud auth application-default login` once.
# Model, e.g. gemini-embedding-001 (the database stores 768-dimension vectors)
EUREKA_EMBEDDING_MODEL=
# Google Cloud project ID and Vertex AI region (e.g. europe-west1)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Texts per embedding request (optional, default: 50)
EUREKA_EMBEDDING_BATCH_SIZE=
